# Somente valores públicos do cliente Supabase (protegidos por RLS).
# Nunca coloque a chave service_role aqui.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Paddle Billing. Nunca misture credenciais sandbox e live no mesmo ambiente.
# NEXT_PUBLIC_PADDLE_ENV deve ser definido explicitamente como sandbox ou production.
NEXT_PUBLIC_PADDLE_ENV=
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=
NEXT_PUBLIC_PADDLE_SMART_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_SMART_YEARLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_PREMIUM_MONTHLY_PRICE_ID=
NEXT_PUBLIC_PADDLE_PREMIUM_YEARLY_PRICE_ID=
PADDLE_API_KEY=
PADDLE_NOTIFICATION_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
