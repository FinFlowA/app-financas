{
  "expo": {
    "name": "FinFlow",
    "owner": "app-financas",
    "slug": "meu-app-financas",
    "version": "2.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon-square-v2.png",
    "scheme": "meuappfinancas",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "O FinFlow usa biometria para proteger o acesso à sua conta financeira."
      },
      "bundleIdentifier": "com.luishpalacio.meuappfinancas"
    },
    "android": {
      "allowBackup": false,
      "adaptiveIcon": {
        "backgroundColor": "#062C2A",
        "foregroundImage": "./assets/images/android-icon-foreground-v2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.luishpalacio.meuappfinancas",
      "permissions": [
        "INTERNET",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/icon-square-v2.png"
    },
    "plugins": [
      "expo-router",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#2A9D8F",
          "sounds": []
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#121212"
          }
        }
      ],
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a7f633f4-8ba5-4adf-8193-5998f8add6ce"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a7f633f4-8ba5-4adf-8193-5998f8add6ce"
    }
  }
}
