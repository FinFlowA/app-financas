# Somente valores públicos do cliente Expo.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Somente para revisão local com dados fictícios. Nunca habilite em builds.
EXPO_PUBLIC_FINFLOW_LOCAL_DEMO=false

# Identificadores publicos do catalogo Google Play (nao sao secrets).
EXPO_PUBLIC_GOOGLE_PLAY_PRO_PRODUCT_ID=finflow_pro
EXPO_PUBLIC_GOOGLE_PLAY_PLUS_PRODUCT_ID=finflow_plus
EXPO_PUBLIC_GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=monthly
EXPO_PUBLIC_GOOGLE_PLAY_ANNUAL_BASE_PLAN_ID=annual

# Nunca use EXPO_PUBLIC_ para Access Token, service_role, webhook secret ou chave da IA.
# Integração web atual: Paddle. As variáveis Paddle pertencem a web/.env.local
# ou ao ambiente server-side da Vercel, conforme web/.env.local.example.

# Configure os valores abaixo exclusivamente como secrets das Supabase Edge Functions.
# O grupo Mercado Pago é legado e não representa o checkout web atual:
# MERCADO_PAGO_ACCESS_TOKEN
# MERCADO_PAGO_WEBHOOK_SECRET
# FINFLOW_BILLING_RETURN_URL
# FINFLOW_ALLOWED_ORIGINS (origens web separadas por vÃ­rgula; apps nativos nÃ£o usam CORS)
# SEND_SMS_HOOK_SECRET
# BREVO_API_KEY
# BREVO_SMS_SENDER
# FINFLOW_AI_PROVIDER (groq ou openai)
# FINFLOW_AI_ROLLOUT_MODE (off, beta ou plans)
# FINFLOW_AI_ALLOWED_EMAILS
# FINFLOW_AI_REQUESTS_PER_MINUTE
# GROQ_API_KEY
# FINFLOW_GROQ_MODEL
# FINFLOW_GROQ_REASONING_EFFORT
# OPENAI_API_KEY
# FINFLOW_OPENAI_MODEL
# FINFLOW_OPENAI_REASONING_EFFORT
# GOOGLE_PLAY_PACKAGE_NAME=com.luishpalacio.meuappfinancas
# GOOGLE_PLAY_PRO_PRODUCT_ID=finflow_pro
# GOOGLE_PLAY_PLUS_PRODUCT_ID=finflow_plus
# GOOGLE_PLAY_MONTHLY_BASE_PLAN_ID=monthly
# GOOGLE_PLAY_ANNUAL_BASE_PLAN_ID=annual
# GOOGLE_PLAY_SERVICE_ACCOUNT_EMAIL
# GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY
# GOOGLE_PLAY_PUBSUB_AUDIENCE (URL publica exata da Edge Function google-play-rtdn)
# GOOGLE_PLAY_PUBSUB_SERVICE_ACCOUNT_EMAIL (identidade OIDC usada no push do Pub/Sub)
